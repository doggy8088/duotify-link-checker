{
  "name": "duotify-link-checker",
  "version": "1.0.0",
  "description": "Chrome extension to check visible links, images, CSS images, video and audio, with on-page reports.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "check": "npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e && node scripts/package.mjs",
    "version:set": "node scripts/version.mjs",
    "publish:store": "node scripts/publish-store.mjs"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "vitest": "^5.0.3"
  },
  "private": true,
  "author": "Will 保哥",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doggy8088/duotify-link-checker.git"
  }
}
